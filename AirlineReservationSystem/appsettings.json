{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=AerovaDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Pricing": {
    "TaxRate": 0.10,
    "InfantMaxAgeYears": 2,
    "ChildMaxAgeYears": 12,
    "InfantFareRate": 0.10,
    "ChildFareRate": 1.00
  },
  "Booking": {
    "SeatHoldMinutes": 15,
    "ExpiryCheckIntervalSeconds": 60
  },
  "FlightGeneration": {
    "DaysAhead": 90,
    "WorkerEnabled": true,
    "DailyRunTimeUtc": "02:00",
    "RunOnStartup": false
  },
  "Seed": {
    "Enabled": false,
    "GenerateFlights": true
  },
  "Jwt": {
    "Issuer": "AEROVA",
    "Audience": "AEROVA.Client",
    "ExpiryMinutes": 60
  },
  "AllowedHosts": "*"
}
