{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=AerovaDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Pricing": {
    "TaxRate": 0.10,
    "InfantMaxAgeYears": 2,
    "ChildMaxAgeYears": 12,
    "InfantFareRate": 0.10,
    "ChildFareRate": 1.00
  },
  "Booking": {
    "SeatHoldMinutes": 15,
    "ExpiryCheckIntervalSeconds": 60
  },
  "BookingLifecycle": {
    "WorkerEnabled": true,
    "CheckIntervalSeconds": 60,
    "RefundProcessingAfterMinutes": 5,
    "RefundCompletedAfterMinutes": 30,
    "CheckInReminderHours": 24
  },
  "TravelDocuments": {
    "Domestic": {
      "AZ": { "Documents": [ "Passport" ], "ByNationality": { "AZ": [ "NationalIdCard", "Passport" ] } }
    },
    "International": {
      "TR": { "Documents": [ "Passport" ], "ByNationality": { "AZ": [ "Passport", "NationalIdCard" ] } },
      "AE": { "Documents": [ "Passport" ], "MinValidityDays": 180 }
    },
    "InternationalDefault": { "Documents": [ "Passport" ], "MinValidityDays": 0 }
  },
  "FlightGeneration": {
    "DaysAhead": 90,
    "WorkerEnabled": true,
    "DailyRunTimeUtc": "02:00",
    "RunOnStartup": false
  },
  "Seed": {
    "Enabled": false,
    "GenerateFlights": true,
    "CreateAdmin": false
  },
  "Jwt": {
    "Issuer": "AEROVA",
    "Audience": "AEROVA.Client",
    "ExpiryMinutes": 43200
  },
  "Auth": {
    "FrontendBaseUrl": "http://localhost:5500"
  },
  "Stripe": {
    "Currency": "usd",
    "CheckoutMinutes": 31
  },
  "Payments": {
    "AllowMockPayments": false
  },
  "TravelAssistant": {
    "Provider": "Anthropic",
    "Model": "claude-haiku-5-5",
    "Endpoint": "https://api.anthropic.com/v1/messages",
    "TimeoutSeconds": 30,
    "MaxOutputTokens": 700,
    "MaxMessageLength": 2000,
    "MaxMessages": 20,
    "MaxTotalLength": 12000,
    "RateLimitPerMinute": 10
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Security": "StartTls",
    "SenderName": "AEROVA"
  },
  "AllowedHosts": "*"
}
