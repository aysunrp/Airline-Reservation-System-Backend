{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Payments": {
    "AllowMockPayments": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5500",
      "http://127.0.0.1:5500"
    ]
  },
  "Auth": {
    "EmailCooldownSeconds": 0,
    "RateLimitPerMinute": 10000,
    "LookupRateLimitPerMinute": 10000
  },
  "Newsletter": {
    "ResendCooldownMinutes": 0,
    "RateLimitPerMinute": 10000
  },
  "Support": {
    "DuplicateWindowSeconds": 0,
    "RateLimitPerMinute": 10000
  },
  "Booking": {
    "ExpiryCheckIntervalSeconds": 5
  },
  "BookingLifecycle": {
    "CheckIntervalSeconds": 5
  }
}
